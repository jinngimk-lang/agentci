{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentci.dev/schemas/target-manifest.schema.json",
  "title": "AgentCI Target Manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "transport", "command", "capabilities", "limits"],
  "properties": {
    "schema_version": {"const": "agentci-target/v0.1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "transport": {"const": "json-stdio-v1"},
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"type": "string"}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inspect", "trajectory", "artifacts"],
      "properties": {
        "inspect": {"type": "boolean"},
        "trajectory": {"type": "boolean"},
        "artifacts": {"type": "boolean"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "stdout_bytes", "stderr_bytes"],
      "properties": {
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 86400},
        "stdout_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "stderr_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824}
      }
    }
  }
}